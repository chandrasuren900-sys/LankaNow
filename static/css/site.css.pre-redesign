:root{--ink:#151922;--ink2:#1d2330;--red:#b4232f;--muted:#697386;--paper:#f4f5f7;--line:#dde0e5;--white:#fff}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;color:var(--ink);background:#fff;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6}a{color:inherit;text-decoration:none}a:hover{color:var(--red)}button,input,textarea,select{font:inherit}button,a,input,textarea{touch-action:manipulation}button{cursor:pointer}img{max-width:100%;display:block}h1,h2,h3,p{margin-top:0}h1,h2,h3{line-height:1.12}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #b4232f;outline-offset:4px}.wrap{width:min(1280px,calc(100% - 80px));margin:auto}.utility{background:var(--ink);color:#b9bec9;font-size:10px;letter-spacing:1.3px;padding:9px 0}.utility .wrap{display:flex;justify-content:space-between}.masthead-inner{display:flex;align-items:center;gap:50px;min-height:119px}.brand{font-size:43px;font-weight:900;letter-spacing:-2.5px;line-height:1;display:inline-block;white-space:nowrap}.brand>span{color:var(--red)}.brand i{display:block;font-style:normal;font-size:10px;letter-spacing:3px;color:var(--muted);margin-top:10px;font-weight:600;text-transform:uppercase}.header-search{display:flex;align-items:center;background:var(--paper);border:1px solid #eaecf0;border-radius:4px;max-width:395px;width:100%;margin-left:auto}.header-search input{border:0;background:transparent;width:100%;padding:12px 16px;font-size:12px}.header-search button{font-size:26px;border:0;background:transparent;padding:0 15px;color:var(--ink)}.outline-button,.button,.light-button{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:12px 18px;font-weight:700;font-size:12px;border:1px solid var(--line);border-radius:3px;white-space:nowrap}.button{background:var(--red);color:white;border-color:var(--red)}.button:hover{background:#8f1d27;color:white}.light-button{background:white;color:var(--ink);