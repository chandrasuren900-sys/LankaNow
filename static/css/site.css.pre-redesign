-line);padding:22px 18px}.topic-grid a:hover{background:var(--paper)}.topic-number{color:#9ca3ae;font-size:9px}.topic-grid h3{font-size:15px;margin:0;flex:1}.topic-grid a>span:last-child{color:var(--red)}.newsletter{background:#f1f2f4;padding:42px 44px;display:grid;grid-template-columns:1fr 1fr;gap:60px;border-top:3px solid var(--red);margin-top:60px;margin-bottom:60px}.newsletter h2{font-family:Georgia,serif;font-size:34px;font-weight:400;letter-spacing:-.8px;margin:13px 0}.newsletter p{font-size:12px;color:var(--muted);margin:0}.newsletter-form{align-self:center;border-left:1px solid #d7dae0;padding-left:40px}.newsletter-form h3{font-size:23px;margin:17px 0 10px}.pill{font-size:8px;letter-spacing:1px;border:1px solid #c9cdd4;border-radius:20px;padding:5px 10px}.newsletter label{font-size:11px;display:block;margin-bottom:8px}.input-row{display:flex;gap:10px}.input-row input{min-width:0;flex:1}.consent{margin-top:14px;color:var(--muted)}.consent input{width:auto;margin-right:5px}.consent a{text-decoration:underline}input,textarea,select{padding:12px;border:1px solid #cbd0d9;border-radius:3px;background:white;width:100%;color:var(--ink)}footer{background:var(--ink);color:#c0c5ce;padding:48px 0 20px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.1fr;gap:40px}.footer-grid .brand{color:white;font-size:38px}.footer-grid p{font-size:12px;line-height:1.9;margin-top:22px}.footer-grid h3{color:white;font-size:11px;margin:0 0 23px}.footer-grid>div>a:not(.brand){display:block;font-size:11px;margin:11px 0}.footer-bottom{display:flex;justify-content:space-between;border-top:1px solid #353b47;padding-top:20px;margin-top:38px;font-size:9px;color:#929bab}.listing{padding:35px 0 20px;min-height:600px}.breadcrumb{font-size:11px;color:var(--muted);margin-bottom:35px}.listing .section-heading{margin-bottom:40px}.listing .section-heading p{margin:15px 0}.empty-page{background:var(--paper);text-align:center;padding:70px 25px}.empty-page h2{font-family:Georgia,serif;font-size:38px;font-weight:400;margin:18px 0}.empty-page p{color:var(--muted);font-size:14px;line-height:1.9}.search-form{max-width:800px;margin-bottom:30px}.search-form label{display:block;font-weight:bold;font-size:12px;margin-bottom:10px}.pagination{display:flex;justify-content:center;align-items:center;gap:25px;margin-top:35px;font-size:12px}.narrow{max-width:780px}.prose-page{padding-top:65px;padding-bottom:30px;min-height:450px}.prose-page h1,.contact-layout h1{font-family:Georgia,serif;font-size:49px;letter-spacing:-1.5px;margin:20px 0 30px}.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:65px;padding-top:70px;padding-bottom:20px}.contact-layout .small{margin-top:25px}.form-panel{background:var(--paper);padding:30px}.form-panel label{display:block;font-size:12px;font-weight:bold;margin-bottom:6px}.errorlist{color:var(--red);font-size:13px}.notices p{background:#f1f2f4;border-left:3px solid var(--red);padding:15px;font-size:14px}.article-wrap{padding-top:35px}.article-header{max-width:900px;margin:0 auto 35px}.article-header h1{font-family:Georgia,serif;font-size:52px;letter-spacing:-1.6px;line-height:1.08;margin:18px 0 24px}.dek{font-size:19px;color:var(--muted);line-height:1.65}.article-byline{display:flex;align-items:center;gap:13px;margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}.article-byline strong{font-size:12px}.author-avatar{display:grid;place-items:center;background:var(--paper);width:40px;height:40px;border-radius:50%;font-family:Georgia,serif;font-size:22px}.article-figure{margin:0 0 40px}.article-figure img{width:100%;max-height:650px;object-fit:cover;height:auto}.article-figure figcaption{color:var(--muted);font-size:11px;padding:10px 0}.article-layout{display:grid;grid-template-columns:minmax(0,2.3fr) minmax(220px,1fr);gap:70px;max-width:1060px;margin:auto}.article-body{font-family:Georgia,'Times New Roman',serif;font-size:20px;line-height:1.85;overflow-wrap:anywhere}.article-body p{margin-bottom:25px}.article-aside{bor