0 0}.footer-grid{grid-template-columns:1fr 1fr;gap:30px 20px}.footer-grid>div:first-child{grid-column:1/-1}.footer-bottom{gap:20px;flex-direction:column}.listing{padding-top:25px}.empty-page{padding:45px 20px}.empty-page h2{font-size:31px}.contact-layout{grid-template-columns:1fr;gap:20px;padding-top:35px}.contact-layout h1,.prose-page h1{font-size:37px}.form-panel{padding:22px}.article-header h1{font-size:36px}.dek{font-size:17px}.article-layout{grid-template-columns:1fr;gap:35px}.article-aside{border:0;padding:25px 0 0;border-top:1px solid var(--line)}.article-body{font-size:18px}.hero-copy h2{font-size:33px}.breaking-inner{gap:15px}.pagination{gap:12px}.pagination .outline-button{padding:10px;font-size:10px}}
