{% load static %}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}{{ title|default:'Sri Lanka, in focus' }} | LankaNow{% endblock %}</title>
<meta name="description" content="{% block description %}News, people and discoveries from across Sri Lanka. LankaNow. Know Now.{% endblock %}">
<link rel="canonical" href="{{ canonical }}"><meta property="og:site_name" content="LankaNow"><meta property="og:url" content="{{ canonical }}">
{% block meta %}<meta property="og:title" content="{{ title|default:'LankaNow — Know Now.' }}"><meta property="og:description" content="Your daily perspective on Sri Lanka."><meta property="og:type" content="website"><meta name="twitter:card" content="summary">{% endblock %}
<link rel="icon" href="{% static 'favicon.svg' %}" type="image/svg+xml"><link rel="stylesheet" href="{% static 'css/site.css' %}"><script src="{% static 'js/site.js' %}" defer></script></head>
<body><a class="skip" href="#main">Skip to content</a><div class="utility"><div class="wrap"><span>SRI LANKA · {% now 'l, d F Y' %}</span><span class="utility-right">A fresh perspective. Every day.</span></div></div>
<header class="masthead"><div class="wrap masthead-inner"><a class="brand" href="/" aria-label="LankaNow homepage">Lanka<span>Now</span><i>Know Now.</i></a><form action="{% url 'search' %}" method="get" class="header-search"><label class="sr-only" for="header-search">Search LankaNow</label><input id="header-search" type="search" name="q" placeholder="Find a story, a person, a place…" value="{{ query }}"><button aria-label="Search">⌕</button></form><a href="/#newsletter" class="outline-button desktop">The newsletter ↗</a><button class="menu-button" aria-expanded="false" aria-controls="navigation">Menu ☰</button></div></header>
<nav id="navigation" class="navigation" aria-label="Main"><div class="wrap nav-inner"><a href="/" {% if request.path == '/' %}aria-current="page"{% endif %}>Home</a>{% for c in categories %}<a href="{{ c.get_absolute_url }}" {% if category == c %}aria-current="page"{% endif %}>{{ c.name }}</a>{% endfor %}</div></nav>
{% if messages %}<div class="wrap notices" role="status">{% for message in messages %}<p>{{ message }}</p>{% endfor %}</div>{% endif %}
<main id="main">{% block content %}{% endblock %}</main>
<section id="newsletter" class="newsletter wrap"><div><span class="eyebrow">THE LANKANOW LETTER</span><h2>A little more perspective.<br>A lot less noise.</h2><p>The stories that matter, delivered to your inbox.</p></div><div class="newsletter-form">{% if mail_available %}<form action="{% url 'subscribe' %}" method="post">{% csrf_token %}<label for="newsletter-email">Your email address</label><div class="input-row"><input type="email" name="email" id="newsletter-email" placeholder="you@example.com" required><button class="button">Sign me up ↗</button></div><label class="consent"><input type="checkbox" name="consent" required> I agree to receive emails and accept the <a href="/privacy/">privacy policy</a>.</label></form>{% else %}<span class="pill">COMING SOON</span><h3>Your next daily read.</h3><p>Our newsletter is taking shape. Check back for signup.</p>{% endif %}</div></section>
<footer><div class="wrap footer-grid"><div><a class="brand" href="/">Lanka<span>Now</span><i>Know Now.</i></a><p>One island. Many stories.<br>Your daily perspective on Sri Lanka.</p></div><div><h3>Stay informed</h3><a href="/news/">News</a><a href="/trending/">Trending</a><a href="/sports/">Sports</a><a href="/tech/">Technology</a></div><div><h3>Explore more</h3><a href="/people/">People</a><a href="/food/">Food & culture</a><a href="/travel/">Travel</a><a href="/events/">Events</a></div><div><h3>LankaNow</h3><a href="/about/">About us</a><a href="/contact/">Contact the newsroom</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms of use</a></div></div><div class="wrap footer-bottom"><span>© {% now 'Y' %} LankaNow. All rights reserved.</span><span>Made for the way Sri Lanka reads.</span></div></footer>
</body></html>
