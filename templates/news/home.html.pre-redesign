{% extends 'news/base.html' %}{% block content %}
{% if breaking %}<div class="breaking"><div class="wrap breaking-inner"><strong><span class="live-dot"></span> BREAKING</strong><div>{% for story in breaking %}<a href="{{ story.get_absolute_url }}">{{ story.title }} <span>↗</span></a>{% endfor %}</div></div></div>{% endif %}
<div class="wrap home-top"><div class="section-heading"><div><span class="eyebrow">THE DAILY PERSPECTIVE</span><h1>Sri Lanka. In focus<span class="red">.</span></h1></div><span class="edition">THE LANKANOW EDITION <span class="red">/</span> {% now 'd.m.Y' %}</span></div>
<div class="lead-layout"><section>{% if hero %}<article class="hero-story">{% if hero.featured_image %}<a href="{{ hero.get_absolute_url }}"><img class="hero-image" src="{{ hero.featured_image.image.url }}" alt="{{ hero.featured_image.alt_text }}" width="1200" height="700" fetchpriority="high"></a>{% endif %}<div class="hero-copy"><span class="eyebrow">{{ hero.category.name }} · THE BIG READ</span><h2><a href="{{ hero.get_absolute_url }}">{{ hero.title }}</a></h2><p>{{ hero.summary }}</p><div class="meta">By {{ hero.author.get_full_name|default:hero.author.username }} <span>•</span> {{ hero.published_at|date:'d M Y' }} <span>•</span> {{ hero.reading_minutes }} min read</div></div></article>{% else %}<div class="welcome-feature"><div class="welcome-top"><span class="eyebrow">WELCOME TO LANKANOW</span><span class="outline-pill">01 / A NEW PERSPECTIVE</span></div><h2>One island.<br>Many stories<span>.</span></h2><p>From the headlines to the hidden gems.<br>A new home for everything Sri Lanka.</p><a href="/about/" class="light-button">Meet LankaNow <span>↗</span></a><div class="welcome-bottom"><span>NEWS / PEOPLE / EVERYDAY DISCOVERIES</span><b>LN<span>.</span></b></div></div>{% endif %}</section>
<aside class="trending-panel"><div class="section-label"><h2>On the radar</h2><span class="red">↗</span></div><p class="muted small">What readers are paying attention to.</p>{% for story in trending %}<article class="ranked"><span class="rank">0{{ forloop.counter }}</span><div><span class="eyebrow">{{ story.category.name }}</span><h3><a href="{{ story.get_absolute_url }}">{{ story.title }}</a></h3><span class="meta">{{ story.reading_minutes }} min read</span></div></article>{% empty %}<div class="radar-empty"><span class="radar-icon">◎</span><h3>The conversation<br>starts here.</h3><p>Popular stories will appear here as readers explore LankaNow.</p></div>{% endfor %}<a class="text-link" href="/trending/">Explore trending <span>↗</span></a></aside></div>
<section class="section"><div class="section-label"><h2>The latest<span class="red">.</span></h2><a class="text-link" href="/news/">All news ↗</a></div>{% if latest %}<div class="card-grid">{% for story in latest %}{% include 'news/card.html' %}{% endfor %}</div>{% else %}<div class="empty-inline"><div><span class="eyebrow">STAY CURIOUS</span><h3>Fresh stories are on the way.</h3><p>Our latest published updates will appear here.</p></div><a class="outline-button" href="/news/">Explore news ↗</a></div>{% endif %}</section>
<section class="explore-strip"><div><span class="eyebrow">BEYOND THE HEADLINES</span><h2>Find your next<br> good discovery.</h2></div><a href="/jobs/"><span>01 / OPPORTUNITIES</span><h3>Jobs ↗</h3><p>Your next chapter starts here.</p></a><a href="/deals/"><span>02 / SMART FINDS</span><h3>Deals ↗</h3><p>More value in the everyday.</p></a><a href="/events/"><span>03 / WHAT’S ON</span><h3>Events ↗</h3><p>Step out. Be part of it.</p></a></section>
{% for c,stories in sections %}{% if stories %}<section class="section"><div class="section-label"><h2>{{ c.name }}<span class="red">.</span></h2><a class="text-link" href="{{ c.get_absolute_url }}">Explore {{ c.name|lower }} ↗</a></div><div class="card-grid">{% for story in stories %}{% include 'news/card.html' %}{% endfor %}</div></section>{% endif %}{% endfor %}
<section class="section"><div class="section-label"><h2>Your island. Your interests.</h2><span class="muted small">TWELVE WAYS TO EXPLORE</span></div><div class="topic-grid">{% for c in categories %}<a href="{{ c.get_absolute_url }}"><span class="topic-number">{{ forloop.counter|stringformat:'02d' }}</span><h3>{{ c.name }}</h3><span>↗</span></a>{% endfor %}</div></section></div>
{% endblock %}
