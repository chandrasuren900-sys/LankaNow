# These are examples. Export the variables in your host; Django does not auto-read .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-generated-on-your-server
DJANGO_ALLOWED_HOSTS=lankanow.lk,www.lankanow.lk
SITE_URL=https://lankanow.lk
